{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Pacman",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\src\\GUI\\pacman.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}\\src\\GUI",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "Build Pacman",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
